# =========================================================================
# Локальная разработка (docker compose up -d postgres)
# =========================================================================
DATABASE_URL="postgresql://pathlogs:pathlogs@localhost:5433/pathlogs"
# Прямое соединение для миграций. Локально совпадает с DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://pathlogs:pathlogs@localhost:5433/pathlogs"

# =========================================================================
# Production (Neon PostgreSQL) — задайте в .env.production или в переменных
# окружения хостинга. DATABASE_URL — пул соединений (-pooler),
# DATABASE_URL_UNPOOLED — прямое соединение (без -pooler) для миграций.
# Пример:
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
#   DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
# =========================================================================

# ОБЯЗАТЕЛЬНО сгенерируйте свой: `openssl rand -base64 32`.
# Значение ниже — заглушка, оно лежит в публичном репозитории. Из этого же
# секрета выводится ключ шифрования учётных данных Trello (src/lib/crypto.ts),
# поэтому в продакшене чужой AUTH_SECRET = чужой доступ к ним.
AUTH_SECRET="ЗАМЕНИТЕ-МЕНЯ-сгенерированным-секретом"
AUTH_TRUST_HOST="true"

# Вход через Google (опционально). Если пусто — кнопка входа не показывается.
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Почта для еженедельных отчётов (опционально).
# При пустых значениях письма пишутся в консоль, а не отправляются.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# S3-совместимое хранилище (AWS S3 / Cloudflare R2 / MinIO).
# При пустых значениях файлы сохраняются локально в ./uploads.
# Бакет держим ПРИВАТНЫМ: файлы отдаёт /api/files/[key] по подписанной
# ссылке после проверки прав, публичный домен бакета не нужен.
# S3_ENDPOINT — только хост, без имени бакета в пути.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_ENDPOINT=""

# Порог, после которого загрузка файлов блокируется (байты).
# По умолчанию 10 ГБ — бесплатная квота Cloudflare R2.
STORAGE_QUOTA_BYTES=""
